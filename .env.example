# Copy to .env.local for development, or set these in your host's dashboard.
# Never commit .env.local — .gitignore already excludes it.

# --- Required for the editor (/admin) -------------------------------------
# Shared Student Government editor password. Minimum 12 characters.
# Admin is disabled entirely while this is unset; there is no default.
ADMIN_PASSWORD=

# Optional. Signs editor session cookies. Falls back to ADMIN_PASSWORD when
# unset; set it separately so rotating the password does not have to invalidate
# every session, and vice versa. Use a long random string.
ADMIN_SESSION_SECRET=

# --- Recommended ----------------------------------------------------------
# Absolute public origin. Used for canonical URLs, the sitemap, and OG tags.
NEXT_PUBLIC_SITE_URL=https://navigate.example.org

# --- Optional -------------------------------------------------------------
# Directory for the JSON/JSONL data files (submissions, content overrides).
# Defaults to ./.data. Point this at a mounted volume on hosts whose app
# directory is read-only.
NAVIGATE_DATA_DIR=

# Optional webhook that receives a short notice when an issue is submitted
# (Slack or Discord incoming webhook, Zapier catch hook, Apps Script URL).
# Only the title, category, and a truncated excerpt are sent. Contact details
# are never transmitted. Leave blank to disable.
ISSUE_WEBHOOK_URL=
