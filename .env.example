# Copy to .env.local for development, or set these in your host's dashboard.
# Never commit .env.local — .gitignore already excludes it.

# --- Required for the editor (/admin) -------------------------------------
# Shared Student Government editor password. Minimum 12 characters.
# Admin is disabled entirely while this is unset; there is no default.
ADMIN_PASSWORD=

# Optional. Signs editor session cookies. Falls back to ADMIN_PASSWORD when
# unset; set it separately so rotating the password does not have to invalidate
# every session, and vice versa. Use a long random string.
ADMIN_SESSION_SECRET=

# --- Recommended ----------------------------------------------------------
# Absolute public origin. Used for canonical URLs, the sitemap, and OG tags.
NEXT_PUBLIC_SITE_URL=https://navigate.example.org

# --- Optional -------------------------------------------------------------
# Directory for the JSON/JSONL data files (submissions, content overrides).
# Defaults to ./.data. Point this at a mounted volume on hosts whose app
# directory is read-only.
NAVIGATE_DATA_DIR=

# --- Where issue submissions go --------------------------------------------
# At least one durable path is required, or the form refuses every submission
# (by design: it never accepts something it cannot store).
#
# On a host with a writable disk, the disk is enough and both of these are
# optional. On Vercel the filesystem is read-only, so ISSUE_STORE_URL is
# REQUIRED.

# The system of record. Receives the FULL record, contact email included.
# Point this only at an endpoint Student Government controls.
# For the Google Sheet setup in scripts/apps-script-store.gs, append the token
# to the URL:  https://script.google.com/macros/s/AKfy.../exec?token=YOUR-TOKEN
ISSUE_STORE_URL=

# Optional shared secret, sent as the x-navigate-token header. Used by sinks
# that can read request headers. Apps Script cannot, so leave this unset there
# and put the token in ISSUE_STORE_URL instead.
ISSUE_STORE_TOKEN=

# Optional chat notification (Slack or Discord incoming webhook). Receives the
# title, category, and a truncated excerpt ONLY. Contact details are never sent
# here, because a webhook URL sits in a channel many people can read. This is a
# notification, never the system of record. Leave blank to disable.
ISSUE_WEBHOOK_URL=
